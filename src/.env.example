# このファイルを .env にコピーし、必要に応じて認証情報を調整してください。
# ここに記載の値はローカル開発向けの安全な初期値です。本番で使用する前に必ずパスワードを置き換えてください。

DB_HOST=db
DB_PORT=3306
DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=change_me

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me
TZ=Asia/Tokyo
